HOST=127.0.0.1
# Set true only when the app is behind a trusted reverse proxy.
TRUST_PROXY=false
PORT=3025
DB_STORAGE=database/reminder_bot.sqlite
# DATABASE_URL=postgres://user:password@localhost:5432/reminder_bot
DB_BACKUP_RETENTION_DAYS=3
# Optional API key. Leave empty to disable API-key access.
WEB_API_KEY=
AUTH_USERNAME=
# Minimum 12 characters.
AUTH_PASSWORD=
# Login throttling: jumlah percobaan dan durasi dalam milidetik.
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOGIN_WINDOW=900000
AUTH_LOGIN_LOCKOUT=900000
# Generate at least 32 random characters, for example: openssl rand -hex 32
SESSION_SECRET=
SENT_HISTORY_RETENTION_MONTHS=3
SENT_HISTORY_CLEANUP_SCHEDULE=15 0 * * *

# MikroTik API untuk registrasi pelanggan hotspot
IP_MIKROTIK=
USER_MIKROTIK=
PASSWORD_MIKROTIK=
PORT_MIKROTIK=8728
# Fallback untuk RouterOS lama yang tidak bisa membaca export besar melalui API.
PORT_MIKROTIK_FTP=21
MIKROTIK_FTP_TIMEOUT=30000
# Optional: use RouterOS api-ssl (normally port 8729) to encrypt API traffic.
# When false, sensitive backup data travels unencrypted over the network.
MIKROTIK_TLS=false
MIKROTIK_TLS_REJECT_UNAUTHORIZED=true

# Optional backup router
IP_MIKROTIK_BACKUP=
PORT_MIKROTIK_BACKUP=8728
PORT_MIKROTIK_BACKUP_FTP=21
MIKROTIK_BACKUP_TLS=false
MIKROTIK_BACKUP_TLS_REJECT_UNAUTHORIZED=true

# Provider default tetap Baileys. Nilai valid: baileys atau android.
WHATSAPP_PROVIDER=baileys
# Satu worker disarankan untuk STB dan WhatsApp Android UI automation.
WHATSAPP_QUEUE_CONCURRENCY=1
WHATSAPP_RETRY_LIMIT=3
# Detik sebelum reminder yang gagal dicoba lagi oleh scheduler existing.
WHATSAPP_RETRY_DELAY=30

# WhatsApp langsung melalui Baileys v7 (Linked Devices).
# Buka /transport setelah login untuk memindai QR. Setelah terhubung,
# periksa antrean lalu aktifkan pengiriman secara manual dari halaman yang sama.
BAILEYS_ENABLED=true
BAILEYS_AUTH_STORAGE=database/baileys_auth.sqlite
BAILEYS_BROWSER_NAME=Reminder Bot
BAILEYS_CONNECT_TIMEOUT=30000
BAILEYS_QUERY_TIMEOUT=30000

WA_MESSAGE_DELAY=2000
# Rentang jeda acak antar semua pesan WhatsApp (milidetik).
# WA_MESSAGE_DELAY tetap dipakai sebagai fallback minimum untuk kompatibilitas.
WA_MESSAGE_DELAY_MIN=2000
WA_MESSAGE_DELAY_MAX=5000
# Pesan WhatsApp hanya dicoba satu kali. Pengaturan ini khusus reconnect perangkat.
BAILEYS_RECONNECT_MAX_DELAY=30000

# AndroidProvider -> local bridge -> Appium/UiAutomator2 -> Waydroid.
# URL selain loopback akan ditolak.
ANDROID_BRIDGE_URL=http://127.0.0.1:3030
ANDROID_BRIDGE_TOKEN=
ANDROID_BRIDGE_TIMEOUT=15000

# Dipakai process bridge/whatsapp-bridge.js.
ANDROID_BRIDGE_HOST=127.0.0.1
ANDROID_BRIDGE_PORT=3030
APPIUM_URL=http://127.0.0.1:4723
# Optional bila executable Appium tidak ada di PATH service.
APPIUM_BIN=appium
# Debian package `adb` installs the SDK platform tools in this directory.
ANDROID_HOME=/usr/lib/android-sdk
ANDROID_SDK_ROOT=/usr/lib/android-sdk
# Isi bila adb memiliki lebih dari satu device, contoh 192.168.240.112:5555.
ANDROID_ADB_SERIAL=
WHATSAPP_PACKAGE=com.whatsapp
# Override hanya setelah memeriksa selector dengan Appium Inspector.
ANDROID_SEND_XPATH='//*[@content-desc="Send" or @content-desc="Kirim"]'
ANDROID_CONFIRM_TIMEOUT_MS=12000
# ARM64 STB dengan ART interpreter dapat memerlukan waktu lebih lama untuk UiAutomator2.
ANDROID_APPIUM_SESSION_TIMEOUT_MS=120000
ANDROID_AUTO_START_WHATSAPP=true
# true bila bridge harus memulai satu proses Appium lokalnya sendiri.
ANDROID_BRIDGE_MANAGE_APPIUM=true

# Telegram transport untuk file backup MikroTik
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_API_URL=https://api.telegram.org
