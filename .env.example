HOST=127.0.0.1
# Set true only when the app is behind a trusted reverse proxy.
TRUST_PROXY=false
PORT=3025
DB_STORAGE=database/reminder_bot.sqlite
# DATABASE_URL=postgres://user:password@localhost:5432/reminder_bot
DB_BACKUP_RETENTION_DAYS=3
# Optional API key. Leave empty to disable API-key access.
WEB_API_KEY=
AUTH_USERNAME=
# Minimum 12 characters.
AUTH_PASSWORD=
# Login throttling: jumlah percobaan dan durasi dalam milidetik.
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOGIN_WINDOW=900000
AUTH_LOGIN_LOCKOUT=900000
# Generate at least 32 random characters, for example: openssl rand -hex 32
SESSION_SECRET=
SENT_HISTORY_RETENTION_MONTHS=3
SENT_HISTORY_CLEANUP_SCHEDULE=15 0 * * *

# MikroTik API untuk registrasi pelanggan hotspot
IP_MIKROTIK=
USER_MIKROTIK=
PASSWORD_MIKROTIK=
PORT_MIKROTIK=8728
# Required for sensitive backup export. Configure RouterOS api-ssl, normally port 8729.
MIKROTIK_TLS=false
MIKROTIK_TLS_REJECT_UNAUTHORIZED=true

# Optional backup router
IP_MIKROTIK_BACKUP=
PORT_MIKROTIK_BACKUP=8728
MIKROTIK_BACKUP_TLS=false
MIKROTIK_BACKUP_TLS_REJECT_UNAUTHORIZED=true

# WhatsApp langsung melalui Baileys v7 (Linked Devices).
# Buka /transport setelah login untuk memindai QR atau membuat pairing code.
BAILEYS_ENABLED=true
BAILEYS_AUTH_STORAGE=database/baileys_auth.sqlite
BAILEYS_BROWSER_NAME=Reminder Bot
BAILEYS_CONNECT_TIMEOUT=30000
BAILEYS_QUERY_TIMEOUT=30000

WA_MESSAGE_DELAY=2000
# Rentang jeda acak antar semua pesan WhatsApp (milidetik).
# WA_MESSAGE_DELAY tetap dipakai sebagai fallback minimum untuk kompatibilitas.
WA_MESSAGE_DELAY_MIN=2000
WA_MESSAGE_DELAY_MAX=5000
WA_RETRY_MAX_ATTEMPTS=3
WA_RETRY_BASE_DELAY=5000
WA_RETRY_MAX_DELAY=30000

# Telegram transport untuk file backup MikroTik
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_API_URL=https://api.telegram.org
