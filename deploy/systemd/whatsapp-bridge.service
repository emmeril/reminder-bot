[Unit]
Description=Local WhatsApp Android accessibility bridge
Wants=network-online.target waydroid-container.service waydroid-headless-ready.service
After=network-online.target waydroid-container.service waydroid-headless-ready.service

[Service]
Type=simple
User=reminderbot
Group=reminderbot
WorkingDirectory=/opt/reminder-bot
EnvironmentFile=/opt/reminder-bot/.env
Environment=NODE_ENV=production
Environment=ANDROID_BRIDGE_HOST=127.0.0.1
Environment=ANDROID_HOME=/usr/lib/android-sdk
Environment=ANDROID_SDK_ROOT=/usr/lib/android-sdk
Environment=ANDROID_BRIDGE_MANAGE_APPIUM=true
Environment=ANDROID_AUTO_START_WHATSAPP=true
ExecStart=/usr/bin/node /opt/reminder-bot/bridge/whatsapp-bridge.js
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
